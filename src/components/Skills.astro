---
import { skillCategories } from '../data/skills';
---

<section class="sec" id="skills">
  <div class="section-header" data-rv>
    <span class="section-tag">03 / Core Competencies</span>
    <h2 class="section-title">Technical Skills &amp; Stack</h2>
    <p class="section-desc">
      Core programming languages, machine learning frameworks, distributed tools, and developer workflows.
    </p>
  </div>

  <div class="skills-grid">
    {skillCategories.map((category) => (
      <div class="skill-bento-card spotlight-card" data-rv>
        <h3 class="skill-bento-title">{category.title}</h3>
        <div class="skill-pills-wrap">
          {category.skills.map((skill) => (
            <span class="skill-pill-item">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
