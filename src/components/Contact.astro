---
import { profile } from '../data/profile';
---

<section class="sec" id="contact">
  <div class="contact-banner spotlight-card" data-rv>
    <span class="section-tag" style="justify-content: center;">05 / Connect</span>
    <h2 class="contact-h2">
      Let's build something<br />exceptional together.
    </h2>
    <p class="section-desc" style="text-align: center; max-width: 520px;">
      Actively seeking backend engineering, distributed systems, and AI/ML software developer roles.
    </p>

    <button 
      class="contact-email-btn" 
      data-copy-email 
      title="Click to copy email address"
      aria-label={`Copy email ${profile.email}`}
    >
      <span>{profile.email}</span>
      <span style="opacity: 0.7;">📋</span>
    </button>

    <div class="hero-socials" style="margin-top: 8px;">
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hero-social-link">
        GitHub ↗
      </a>
      <span style="color: var(--border-medium);">·</span>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hero-social-link">
        LinkedIn ↗
      </a>
    </div>
  </div>
</section>
