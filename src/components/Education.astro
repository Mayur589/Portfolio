---
import { degrees, certifications } from '../data/education';
---

<section class="sec" id="education">
  <div class="section-header" data-rv>
    <span class="section-tag">04 / Credentials</span>
    <h2 class="section-title">Education &amp; Certification</h2>
    <p class="section-desc">
      Academic background in Computer Science &amp; Engineering alongside verified professional certifications.
    </p>
  </div>

  <div class="edu-grid">
    {degrees.map((deg) => (
      <div class="edu-bento-card spotlight-card" data-rv>
        <div class="edu-header-row">
          <h3 class="edu-inst-name">{deg.institution}</h3>
          <span class="edu-period-badge">{deg.period}</span>
        </div>
        <p class="edu-degree-title">{deg.degree}</p>
        <div class="edu-score-badge">
          Current CGPA: <strong>8.84 / 10</strong>
        </div>
        <p class="edu-desc-text">{deg.details}</p>
      </div>
    ))}

    {certifications.map((cert) => (
      <div class="edu-bento-card spotlight-card" data-rv>
        <div class="edu-header-row">
          <h3 class="edu-inst-name">{cert.title}</h3>
          <span class="edu-period-badge">{cert.issuer}</span>
        </div>
        <p class="edu-degree-title">{cert.type}</p>
        <p class="edu-desc-text">{cert.details}</p>
      </div>
    ))}
  </div>
</section>
