---
import { profile } from '../data/profile';
---

<section class="hero-sec" id="hero">
  <!-- Left Column: Master Introduction Bento Card -->
  <div class="hero-main-card spotlight-card" data-rv>
    <div>
      <div class="status-badge">
        <span class="status-dot"></span>
        <span>Available for Software &amp; AI Roles</span>
      </div>

      <p class="hero-name">{profile.name} // PORTFOLIO '26</p>

      <h1 class="hero-title">
        Engineering robust systems with precision &amp; clarity.
      </h1>

      <p class="hero-lead">
        Computer Science &amp; Engineering student at <strong>VIT Chennai</strong>. Specializing in high-throughput <strong>Go</strong> backends, low-level <strong>C/C++</strong> hardware control, and <strong>PyTorch</strong> deep learning architectures.
      </p>
    </div>

    <div class="hero-actions">
      <a href="#projects" class="btn-primary">Explore Projects ↓</a>
      <a href="#contact" class="btn-secondary">Get in touch ↗</a>
      <button class="btn-secondary" data-copy-email title="Copy email to clipboard">
        Copy Email 📋
      </button>
    </div>
  </div>

  <!-- Right Column: Studio Telemetry Deck -->
  <div class="hero-telemetry-deck" data-rv>
    <!-- Card 1: Core Specialization -->
    <div class="telemetry-card spotlight-card">
      <div class="telemetry-header">
        <span class="telemetry-label">Specialization &amp; Stack</span>
        <span class="telemetry-chip" style="color: #ffffff; background: rgba(255,255,255,0.08);">Core</span>
      </div>
      <div class="telemetry-chips">
        <span class="telemetry-chip">Go Systems</span>
        <span class="telemetry-chip">PyTorch &amp; LSTM</span>
        <span class="telemetry-chip">Low-Level C</span>
        <span class="telemetry-chip">Distributed Tools</span>
        <span class="telemetry-chip">REST &amp; WebSockets</span>
      </div>
    </div>

    <!-- Card 2: Location & Mobility -->
    <div class="telemetry-card spotlight-card">
      <div class="telemetry-header">
        <span class="telemetry-label">Location &amp; Mobility</span>
        <span class="telemetry-label" style="color: #34d399;">● Online</span>
      </div>
      <p class="telemetry-val">
        Chennai, India · Open to Remote &amp; Global Relocation
      </p>
    </div>

    <!-- Card 3: Metrics Grid -->
    <div class="hero-metrics-grid">
      <div class="metric-card spotlight-card">
        <span class="metric-num">8.84</span>
        <span class="metric-label">CGPA / 10</span>
      </div>
      <div class="metric-card spotlight-card">
        <span class="metric-num">06+</span>
        <span class="metric-label">Projects</span>
      </div>
      <div class="metric-card spotlight-card">
        <span class="metric-num">02</span>
        <span class="metric-label">Internships</span>
      </div>
    </div>
  </div>
</section>
