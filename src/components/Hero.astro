---
import { profile } from '../data/profile';
---

<section class="hero sec" id="hero" data-chapter="0">
  <div class="hero-top">
    <!-- Live Status Badge -->
    <div class="status-badge" data-rv>
      <span class="status-dot"></span>
      <span>Available for New Opportunities</span>
    </div>

    <h1 class="display h-hero" data-rv>
      <span class="mask-line"><span>{profile.headlineLine1}</span></span>
      <span class="mask-line"><span>with clarity &amp; <em>precision.</em></span></span>
    </h1>

    <p class="lead hero-sub" data-rv>
      {profile.lead}
    </p>

    <!-- Modern Action CTAs -->
    <div class="hero-actions" data-rv>
      <a href="#projects" class="btn-primary">Explore Projects ↓</a>
      <a href="#contact" class="btn-secondary">Get in touch ↗</a>
    </div>

    <!-- UI Kit Hero Bento Micro-Widget -->
    <div class="hero-widget" data-rv>
      <div class="widget-row">
        <span class="widget-label">Status</span>
        <span class="widget-val">{profile.status}</span>
      </div>
      <div class="widget-row">
        <span class="widget-label">Core Focus</span>
        <span class="widget-val">{profile.coreFocus}</span>
      </div>
      <div class="widget-row">
        <span class="widget-label">Location</span>
        <span class="widget-val">{profile.location}</span>
      </div>
    </div>
  </div>

  <div class="hero-foot">
    <div class="hero-cue" data-rv>
      <span>Scroll to explore</span>
      <span class="track"><i></i></span>
    </div>
    <div class="chapters" id="chips">
      <div class="chip" data-dest="#experience" data-rv>
        <span class="num">01</span>
        <div class="tx">
          <b>Experience</b>
          <p>Internships at DRDO &amp; Aspirenet.</p>
        </div>
      </div>
      <div class="chip" data-dest="#projects" data-rv>
        <span class="num">02</span>
        <div class="tx">
          <b>Projects</b>
          <p>Mod Manager, Protocol VII &amp; tools.</p>
        </div>
      </div>
      <div class="chip" data-dest="#skills" data-rv>
        <span class="num">03</span>
        <div class="tx">
          <b>Skills</b>
          <p>Go, Python, C/C++, PyTorch &amp; DevOps.</p>
        </div>
      </div>
      <div class="chip" data-dest="#education" data-rv>
        <span class="num">04</span>
        <div class="tx">
          <b>Education</b>
          <p>VIT Chennai &amp; IBM DevOps Certificate.</p>
        </div>
      </div>
    </div>
  </div>
</section>
