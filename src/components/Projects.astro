---
import { projects, projectFilters } from '../data/projects';
---

<section class="sec" id="projects">
  <div class="section-header" data-rv>
    <span class="section-tag">01 / Portfolio Showcase</span>
    <h2 class="section-title">Featured Engineering Projects</h2>
    <p class="section-desc">
      Asymmetric showcase of systems tools, behavioral biometric models, real-time distributed applications, and simulations.
    </p>
  </div>

  <!-- Interactive Project Filter Tabs -->
  <div class="project-filters" data-rv>
    {projectFilters.map((filter, idx) => (
      <button 
        class={`filter-btn ${idx === 0 ? 'active' : ''}`} 
        data-filter={filter.value}
        aria-label={`Filter by ${filter.label}`}
      >
        {filter.label}
      </button>
    ))}
  </div>

  <!-- Asymmetric Bento Grid Showcase -->
  <div class="bento-grid">
    {projects.map((project) => (
      <article 
        class="project-card spotlight-card" 
        data-id={project.id}
        data-category={project.category} 
        data-rv
      >
        <div>
          <div class="project-card-header">
            <span class="project-index">{project.num} // {project.subtitle}</span>
            <span class="project-badge">{project.badge}</span>
          </div>
          <h3 class="project-title">{project.title}</h3>
          <p class="project-desc">{project.description}</p>
          <ul class="project-bullets-list">
            {project.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>

        <div class="project-card-footer">
          <div class="project-tags-group">
            {project.tags.map((tag) => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
          <a 
            href={project.githubUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="project-repo-link" 
            title="View Source on GitHub"
            aria-label={`View GitHub repository for ${project.title}`}
          >
            ↗
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
